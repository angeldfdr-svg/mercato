# Copy to .env locally. Never commit real credentials.
DATABASE_URL=mysql://mercato:CHANGE_ME@127.0.0.1:3306/mercato
APP_URL=http://localhost:3000

# Password recovery email. AUTH_EMAIL_FROM must be a verified Resend sender.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Stripe test-mode credentials for checkout and the webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
