{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": "dist/public/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts?__path=/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
